(text "Notes" (exclude_from_sim no) (at 20.32 160.02 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left top)) (uuid f38851a8-8cd9-5949-b6d0-f5b88948b0f7))
(text "1. Power: LiPo -> Battery Babysitter (charger + BQ27441 gauge) OUT -> Buck-Boost VIN." (exclude_from_sim no) (at 20.32 165.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 92689664-a7a7-544d-a244-a961406b9f59))
(text "   Buck-Boost S1 set to 3V3; VOUT feeds the Nucleo 3V3 pin, XBee VCC, mic VDD and the" (exclude_from_sim no) (at 20.32 168.4 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 0d971f9c-6746-56b1-9534-7aad1efbc9ac))
(text "   Babysitter I2C pull-up supply (V_PU). Nucleo SB21 must be bridged to power AVDD." (exclude_from_sim no) (at 20.32 171.7 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid c8e40b79-1053-5572-85a4-206380d543bd))
(text "2. Mic: I2S1 master RX, MSB-justified, 24-bit data / 32-bit slot, 47.619 kHz (BCLK ~3.05 MHz)." (exclude_from_sim no) (at 20.32 175 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 2a52a1d0-f03b-5517-90e9-a4fd47cead4c))
(text "   L/R tied to GND, so the mic transmits in slot 1. CONFIG pad left open." (exclude_from_sim no) (at 20.32 178.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 27140fb8-ed78-5162-947f-0482e9afac31))
(text "3. Fuel gauge: BQ27441-G1 on I2C1, address 0x55, pull-ups on the Babysitter board." (exclude_from_sim no) (at 20.32 181.6 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 532bd4f8-4ab7-5eb2-aec8-f4347c96d572))
(text "4. XBee 3 Cellular (LTE-M/NB-IoT + GNSS + BLE) on USART1, 115200 8N1, API mode." (exclude_from_sim no) (at 20.32 184.9 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid e007d02f-d973-5b3e-9ecc-940be4d4d528))
(text "   Cellular, GNSS and Bluetooth antennas on the module's U.FL connectors; nano SIM." (exclude_from_sim no) (at 20.32 188.2 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 8e3bcf4a-d0b0-53e6-b136-633941de58f7))
(text "5. Record start/stop: Nucleo user button B1 (PC13, on board)." (exclude_from_sim no) (at 20.32 191.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 727c759f-a00b-5e1a-bf91-d0fb46e61d20))
(text "6. PB6 is set up as a rising-edge EXTI in firmware but is not wired." (exclude_from_sim no) (at 20.32 194.8 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid 6f0d02d9-9c66-5f97-8709-56ee8e36e547))
